--- !u!114 &971398197
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 971398191}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: abf5fc43e772f394088f2053a643d081, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  interactionName: Officer Block
  highlightMaterial: {fileID: 2100000, guid: 2180395c4d877a040afe5beff196a163, type: 2}
  interactSound: {fileID: 8300000, guid: fa5bdb31a19089a4db96c5e5ea47e2e4, type: 3}
  ignoreOutfit: 0
  requiredOutfit: {fileID: 11400000, guid: a842be62f29526d4591c7afedbd5ee51, type: 2}
  wrongOutfitLine: ' Move along now, civilian! Nothing to see here but the  destructive
    aftermath of a vehicular catastrophe!'
  greeting: 'Ah you have availed yourself at last, Detective! Some vandal has given
    the runaround to this low-down and dirty dive! However, the fact is that swarthy
    fellow behind the counter has conducted himself in sinister affairs that dwarf
    the likes of petty theft and burglary, yet simply in favor of the conferring
    of financial dividends we insulate him from consequences first and foremost!
    It''s very funny! It''s called observational comedy, Detective!  '
  dialogueOptions:
  - optionText: 'Who are you? '
    requiredClue: {fileID: 0}
    requiredBoard: {fileID: 0}
    npcResponse: I am Barnabas Block, sheriff apparent to this sordid, languishing
      township! Though I may be lacking in many of the ethical scruples associated
      with my venerable profession, I do so relish the accompanying benefits!
    boardToUnlockOn: {fileID: 0}
    connectionIndexesToUnlock: 
    boardToUnlock: {fileID: 0}
    clueToGive: {fileID: 0}
    outfitToGive: {fileID: 0}
    itemGiven: 0
    objectsToRemove: []
    followUpOptions: []
    isGoodbye: 0
  - optionText: What's the situation, Officer?
    requiredClue: {fileID: 0}
    requiredBoard: {fileID: 0}
    npcResponse: Dire I'm afraid, the hoodlum has fled the scene thereby  leaving
      a path of destruction in his wake, befouled by  unsightly tire tracks not entirely
      dissimilar to the  persistent purple distension lines adorning this  gentlemen's
      engorged abdomen, scars of a warrior sort who  battles daily the turgid results
      of his own patisserie  associated indulgences.(he's weeping)
    boardToUnlockOn: {fileID: 0}
    connectionIndexesToUnlock: 
    boardToUnlock: {fileID: 0}
    clueToGive: {fileID: 0}
    outfitToGive: {fileID: 0}
    itemGiven: 0
    objectsToRemove: []
    followUpOptions: []
    isGoodbye: 0
  - optionText: 'Do you know who''s responsible? '
    requiredClue: {fileID: 0}
    requiredBoard: {fileID: 0}
    npcResponse: "Unfortunately I must concede the vexing rogue is as of yet  at
      large. Now, I can discern by appearance alone that you  are a working man,
      a man of integrity, a mans man, so allow  me to extend some heedworthy advice.
      one man\u2019s mans\u2019 man is  another man\u2019s\u2026 prime suspect. "
    boardToUnlockOn: {fileID: 0}
    connectionIndexesToUnlock: 
    boardToUnlock: {fileID: 0}
    clueToGive: {fileID: 0}
    outfitToGive: {fileID: 0}
    itemGiven: 0
    objectsToRemove: []
    followUpOptions: []
    isGoodbye: 0
  - optionText: Permit me passage beyond this domain, brave sentinel!
    requiredClue: {fileID: 0}
    requiredBoard: {fileID: 0}
    npcResponse: ' For what reason dost thou speak with such pomposity? Art  thou
      perhaps a candy ass? Though, I suppose for a fellow  official a sanction must
      be made. Proceed! '
    boardToUnlockOn: {fileID: 0}
    connectionIndexesToUnlock: 
    boardToUnlock: {fileID: 0}
    clueToGive: {fileID: 0}
    outfitToGive: {fileID: 0}
    itemGiven: 0
    objectsToRemove:
    - {fileID: 1235133321}
    - {fileID: 37884585}
    followUpOptions:
    - optionText: Thank you kind Sir! I shall be on my way
      requiredClue: {fileID: 0}
      requiredBoard: {fileID: 0}
      npcResponse: 
      boardToUnlockOn: {fileID: 0}
      connectionIndexesToUnlock: 
      boardToUnlock: {fileID: 0}
      clueToGive: {fileID: 0}
      outfitToGive: {fileID: 0}
      itemGiven: 0
      objectsToRemove: []
      followUpOptions: []
      isGoodbye: 1
    isGoodbye: 0
